    "section1": {
      "title": "About LEAP Exhibition",
      "subtitle": "The largest technology platform in the region... where ideas are made and the future is born.",
      "description": "LEAP is a turning point in the global tech scene, offering deep insights into the digital future."
    },
    "section2": {
      "title": "SDM's Role in LEAP Coverage",
      "subtitle": "We capture the essence of the event... moments of awe, inspiring stories, and technologies worth telling.",
